{
    "name": "developer-assessment-coding-platform-backend",
    "version": "1.0.0",
    "description": "Developer Assessment & Coding Platform Backend API",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "prisma:validate": "node ./node_modules/prisma/build/index.js validate",
        "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
        "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
        "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
        "test": "echo \"Error: no test specified\" && exit 1",
        "format:check": "node ./node_modules/@biomejs/biome/bin/biome format ./src",
        "format:fix": "node ./node_modules/@biomejs/biome/bin/biome format --write ./src",
        "lint:check": "node ./node_modules/@biomejs/biome/bin/biome lint ./src",
        "lint:fix": "node ./node_modules/@biomejs/biome/bin/biome lint --write ./src"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "google-auth-library": "^11.0.2",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^10.0.0",
        "pg": "^8.22.0",
        "redis": "^6.2.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "prisma": "^7.9.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}