model Company {
  id String @id @default(cuid())

  name String
  slug String @unique

  email       String?
  logoUrl     String?
  description String?
  website     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CompanyMember[]

  assessments Assessment[]
  problems    Problem[]

  @@index([slug])
}