model Company {
  id String @id @default(cuid())

  name String
  slug String @unique

  email       String @unique
  isVerified         Boolean  @default(false)
  isPaymentVerified  Boolean  @default(true)
  logoUrl     String?
  description String?
  website     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  members CompanyMember[]

  assessments Assessment[]
  problems    Problem[]
  payments    Payment[]

  @@index([slug])
}