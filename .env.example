NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/developer_assessment_platform?schema=public"

# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Application Name
APPLICATION_NAME="Developer Assessment & Coding Platform"

# Authentication & JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================================================
# Seed Credentials (src/app/utils/seed.ts)
# ============================================================================

# 1. Super Admin Seed (Role: SUPER_ADMIN)
SUPER_ADMIN_NAME=Tester-Super-Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password

# 2. Platform / Tester Admin Seed (Role: ADMIN)
TESTER_ADMIN_NAME=Tester-Admin
TESTER_ADMIN_EMAIL=testadmin@example.com
TESTER_ADMIN_PASSWORD=your_test_admin_password

# Benchmark Test Company
TEST_COMPANY_NAME="DevAssess Global Tech"
TEST_COMPANY_SLUG="devassess-global-tech"
TEST_COMPANY_EMAIL="contact@devassess.com"

# 3. Company Admin Seed (Role: CANDIDATE, CompanyMemberRole: COMPANY_ADMIN)
TESTED_COMPANY_ADMIN_NAME="Tested Company Admin"
TESTED_COMPANY_ADMIN_EMAIL="tested.companyadmin@devassess.com"
TESTED_COMPANY_ADMIN_PASSWORD="CompanyAdmin123!#"

# 4. Company Recruiter / Owner Seed (Role: CANDIDATE, CompanyMemberRole: COMPANY_OWNER)
TESTED_COMPANY_RECRUITER_NAME="Tested Company Recruiter"
TESTED_COMPANY_RECRUITER_EMAIL="tested.recruiter@devassess.com"
TESTED_COMPANY_RECRUITER_PASSWORD="CompanyRecruiter123!#"

# 5. Assessment Creator Seed (Role: CANDIDATE, CompanyMemberRole: ASSESSMENT_CREATOR)
TESTED_ASSESSMENT_CREATOR_NAME="Tested Assessment Creator"
TESTED_ASSESSMENT_CREATOR_EMAIL="tested.creator@devassess.com"
TESTED_ASSESSMENT_CREATOR_PASSWORD="Creator123!#"

# 6. Evaluator Seed (Role: CANDIDATE, CompanyMemberRole: EVALUATOR)
TESTED_EVALUATOR_NAME="Tested Evaluator"
TESTED_EVALUATOR_EMAIL="tested.evaluator@devassess.com"
TESTED_EVALUATOR_PASSWORD="Evaluator123!#"

# 7. Candidate Seed (Role: CANDIDATE)
TESTED_CANDIDATE_NAME="Tested Candidate"
TESTED_CANDIDATE_EMAIL="tested.candidate@devassess.com"
TESTED_CANDIDATE_PASSWORD="Candidate123!#"

# ============================================================================
# Infrastructure Services
# ============================================================================

# Redis (for Queue/BullMQ & Caching)
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP / Email Notifications
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL_USER=your_email@gmail.com

# Cloudinary (Profile Images, Resumes, Company Logos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Judge0 CE (RapidAPI or Self-Hosted)
JUDGE0_API_KEY=your_judge0_rapidapi_key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
REQUEST_URL=https://judge0-ce.p.rapidapi.com

# bKash Payment
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payment/bkash/callback
BKASH_COMPANY_REGISTRATION_FEE_BDT=1000
